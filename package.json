{
  "name": "@nuanu-ai/apn",
  "version": "0.5.38",
  "description": "Local-first Agent Payment Node CLI",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=24 <27"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "bin": {
    "apn": "bin/apn.js"
  },
  "files": [
    "bin/apn.js",
    "dist/**",
    "data/allowlist/2026-09-17/dataset.json",
    "data/swap/uniswap-ethereum-2026-09-17.json",
    "data/swap/jupiter-solana-abi-blocker-2026-09-17.json",
    "native/BUILD.md",
    "npm-shrinkwrap.json",
    "README.md",
    "docs/solana.md",
    "docs/x402-non-usdc.md",
    "LICENSE",
    "docs/tron.md",
    "docs/lifi.md",
    "docs/gasless.md",
    "docs/evm-assets.md",
    "docs/platform-support.md",
    "data/stargate/2026-09-20/official-registry-and-abi.json",
    "docs/stargate-v2-direct-quote.md",
    "docs/stargate-v2-native-execution.md",
    "docs/stargate-v2-token-native-drop.md",
    "docs/uniswap.md",
    "docs/wbtc-acquisition.md",
    "docs/evidence/wbtc-20261009/**",
    "docs/sunswap.md",
    "docs/jupiter.md",
    "vendor/metamask-evm-sdk/**",
    "vendor/tron-utils/**",
    "vendor/relay-order-id/**",
    "docs/runtime-sdk-vendor.md",
    "vendor/metamask-smart-account/**",
    "docs/relay-base-native.md",
    "docs/wbtc-continuation-budget.md",
    "docs/circle-v2-evm-fast.md",
    "docs/local-release.md",
    "docs/x402-merchant-usdm.md",
    "vendor/x402engine-transfer-proof/**"
  ],
  "scripts": {
    "build:native": "cargo build --offline --release --locked --target aarch64-apple-darwin",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:core",
    "test:core": "npm run build:ts && npm run build:test && node scripts/run-core-tests.mjs dist-test/tests/core/*.test.js && node --test tests/packaging/runtime-dependency-boundary.test.mjs tests/packaging/runtime-reviewed-versions.test.mjs tests/packaging/runtime-metamask-sdk-vendor.test.mjs tests/packaging/runtime-tron-utils-vendor.test.mjs tests/packaging/runtime-relay-order-id-vendor.test.mjs tests/packaging/runtime-smart-account-vendor.test.mjs && node scripts/core-forbidden-surface.mjs",
    "test:legacy-native-contract": "cargo fmt --check && cargo test --offline --locked && cargo clippy --offline --locked --all-targets -- -D warnings",
    "test:legacy-cask-syntax": "node scripts/core-package-syntax.mjs",
    "test:legacy-cask-behavior": "node --test --test-concurrency=1 tests/packaging/*.test.mjs",
    "test:supply-chain": "node --test --test-concurrency=1 tests/packaging/supply-chain.test.mjs",
    "test:source": "npm run test:core",
    "build:test": "tsc -p tsconfig.test.json && node scripts/copy-test-assets.mjs dist-test && node scripts/copy-metamask-sdk-vendor.mjs dist-test/vendor/metamask-evm-sdk && node scripts/copy-tron-utils-vendor.mjs dist-test/vendor/tron-utils && node scripts/copy-relay-order-id-vendor.mjs dist-test/vendor/relay-order-id && node scripts/copy-smart-account-vendor.mjs dist-test/vendor/metamask-smart-account",
    "integration:assemble-app": "node scripts/assemble-macos-app.mjs",
    "prepack": "npm run build && npm test",
    "validate:allowlist-dataset": "node scripts/validate-allowlist-dataset.mjs && node --test scripts/validate-allowlist-dataset.test.mjs",
    "build:metamask-sdk:check": "node scripts/build-sdk-vendor.mjs --check",
    "build:tron-utils:check": "node scripts/build-sdk-vendor.mjs --tron-utils --check",
    "build:relay-order-id:check": "node scripts/build-sdk-vendor.mjs --relay-order-id --check",
    "build:smart-account:check": "node scripts/build-sdk-vendor.mjs --smart-account --check"
  },
  "dependencies": {
    "@metamask/agent-wallet": "6.1.5",
    "@modelcontextprotocol/server": "2.0.0",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.2.0",
    "@x402/core": "2.23.0",
    "@x402/evm": "2.23.0",
    "awal": "2.12.1",
    "viem": "2.55.19",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.5.2",
    "typescript": "5.9.2",
    "@metamask/agent-sdk": "6.1.4",
    "@metamask/fox-sdk": "2.7.0",
    "esbuild": "0.28.2",
    "tronweb": "6.5.0",
    "@relay-protocol/settlement-sdk": "0.0.143",
    "@toruslabs/ethereum-controllers": "9.12.0",
    "@metamask/7715-permission-types": "2.0.0",
    "@metamask/smart-accounts-kit": "2.0.0",
    "@metamask/x402": "1.0.0",
    "@metamask/delegation-core": "3.0.0"
  },
  "overrides": {
    "@solana/web3.js": {
      "jayson": "5.0.0"
    },
    "@metamask/utils": {
      "uuid": "11.1.1"
    },
    "uuid@<11.1.1": "11.1.1",
    "@metamask/number-to-bn": {
      "bn.js": "5.2.5"
    },
    "ethjs-abi": {
      "bn.js": "4.12.5"
    },
    "number-to-bn": {
      "bn.js": "4.12.5"
    },
    "@nktkas/hyperliquid": {
      "valibot": "1.4.2"
    },
    "@ethersproject/providers": {
      "ws": "8.21.3"
    },
    "viem@2.52.2": {
      "ws": "8.21.3"
    },
    "@coral-xyz/anchor": {
      "toml": "4.2.0"
    },
    "viem@2.47.6": {
      "ws": "8.21.3"
    },
    "axios@<0.34.0": "0.34.0",
    "axios@>=1.15.1 <1.20.0": "1.20.0",
    "fast-uri@<3.1.8": "3.1.8",
    "brace-expansion@>=4 <5.0.12": "5.0.12",
    "pbkdf2@<=3.1.6": "3.1.7"
  },
  "license": "MIT",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": ""
}
