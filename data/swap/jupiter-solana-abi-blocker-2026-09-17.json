    {
      "code": "NO_OFFICIAL_EXACT_BUILD_FIXTURE",
      "detail": "The pinned V2 OpenAPI and build guide define response shapes and construction examples but publish no exact SOL-to-USDC /build response fixture with instruction bytes and account metas."
    },
    {
      "code": "ROUTE_PLAN_DOES_NOT_BIND_QUOTED_AMM_KEY",
      "detail": "The JUP6 RoutePlanStep encodes a Swap enum, percent, input_index, and output_index; it does not encode the quoted routePlan swapInfo.ammKey or label."
    },
    {
      "code": "REMAINING_ACCOUNT_ABI_IS_ROUTE_DEPENDENT",
      "detail": "The IDL covers fixed route accounts only. Inner DEX program, pool, vault, oracle, and token accounts are dynamic remaining accounts assembled by AMM adapters and are not described by the JUP6 IDL."
    },
    {
      "code": "NO_PINNED_ONCHAIN_ARTIFACT_PROVENANCE",
      "detail": "No official source found in this review pins a deployed JUP6 executable-data digest or a reproducible-build attestation to the reviewed IDL and builder source."
    },
    {
      "code": "LOCAL_BUILD_CODEC_IS_NOT_V2_BUILD_SHAPE",
      "detail": "The local decoder expects an assembled swapTransaction plus request and fee fields, while official V2 /build returns raw instruction groups and blockhashWithMetadata."
    }
  ],
